{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{config/**,amsat-all-frequencies.csv}"
    }
  },
  "rewrites": [{ "source": "/api/:__vercelPath*", "destination": "/api" }]
}
